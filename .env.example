# ──────────────────────────────────────────────────────────────────────────────
# Polymarket BTC/ETH 5m Automated Trading Assistant — 环境变量模板文件 (.env.example)
# 请复制本文件并重命名为 .env，然后填入您的实际账户凭证。
# ⚠️ 切勿将包含真实私钥的 .env 文件上传至任何公开代码仓库！
# ──────────────────────────────────────────────────────────────────────────────

# 1. POLYMARKET API 凭证 (用于实盘下单交易，dry-run 模式无需填)
# ------------------------------------------------------------------------------
POLY_WALLET_KEY=your_wallet_private_key_here          # 托管钱包私钥 (以 0x 开头的 64 位十六进制)
POLY_PROXY_ADDRESS=your_gnosis_safe_proxy_address     # Polymarket 代理多签 Gnosis Safe 地址 (0x...)
POLY_API_KEY=your_clob_api_key                        # Polymarket CLOB API Key
POLY_API_SECRET=your_clob_api_secret                  # Polymarket CLOB API Secret
POLY_PASSPHRASE=your_clob_api_passphrase              # Polymarket CLOB API Passphrase

# 2. 备用 Polygon 网络节点配置 (Chainlink 链上防线)
# ------------------------------------------------------------------------------
POLYGON_RPC_URL=https://polygon-rpc.com               # 默认 Polygon 快速 RPC 端点
POLYGON_RPC_URLS=https://polygon-rpc.com,https://polygon.drpc.org # 备用 HTTP RPC 列表 (英文逗号分隔)
POLYGON_WSS_URLS=wss://polygon-bor-rpc.publicnode.com             # 备用 WSS RPC 列表 (英文逗号分隔)

# 3. MARSEDGE 信号源密钥
# ------------------------------------------------------------------------------
MARSEDGE_API_KEY=your_marsedge_api_key_here

# 4. 可选的代理加速设置
# ------------------------------------------------------------------------------
# HTTPS_PROXY=socks5://127.0.0.1:1080
# HTTPS_PROXY=http://username:password@your-proxy-ip:port

# 5. API 分发服务器设置 (允许他人授权对接您的 AI 数据)
# ------------------------------------------------------------------------------
API_SERVER_ENABLED=true                                 # 是否启动 API 分发服务器 (true/false)
API_SERVER_PORT=3000                                    # API 分发服务监听端口
API_SERVER_TOKENS=default_token_123,friend_token_abc   # 允许访问的子 Token 列表 (英文逗号分隔)
